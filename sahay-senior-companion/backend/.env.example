# Copy to .env for local reference; never commit a real .env (it is git-ignored).
# NOTE: the app reads these with os.getenv() and does not load .env files itself,
# so export them in your shell (or set them in the Render dashboard) for them to take effect.

# Google Gemini API key. Leave empty to run on the built-in offline engine.
GEMINI_API_KEY=

# Gemini model used when GEMINI_API_KEY is set.
GEMINI_MODEL=gemini-3.6-flash

# Private key that signs sign-in sessions. REQUIRED (32+ characters) for mobile-number sign-in; there is no default.
# Generate one, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Sign in with a mobile number and SMS code (OTP), sent by Twilio Verify. Leave empty to run without it;
# the app then offers "add my name" only. Create a Verify service in the Twilio console to get these.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Countries codes may be sent to (comma-separated). Keeps SMS costs and fraud in check.
SMS_ALLOWED_PREFIXES=+91

# Google Maps Embed API key (enable the Maps Embed API, then restrict the key to your site's HTTP referrer).
# Leave empty and the app shows a plain "Open in Google Maps" link instead of an embedded map.
GOOGLE_MAPS_API_KEY=
